---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const content = {
  de: {
    sectionTag: 'Was der Markt zeigt',
    headline: 'Der Engpass ist die Umsetzung, nicht die Technik',
    stats: [
      {
        value: '57 %',
        label: 'nennen die Identifikation passender Anwendungsfälle als größte Hürde – genau hier setzt unsere Standortbestimmung an.',
        source: 'PwC / TU München, 2025',
      },
      {
        value: '76 %',
        label: 'würden für die Datenhaltung in Europa einen Aufpreis zahlen – unsere Plattform ist in Deutschland gehostet.',
        source: 'adesso, 2026',
      },
    ],
  },
  en: {
    sectionTag: 'What the market shows',
    headline: 'The bottleneck is implementation, not technology',
    stats: [
      {
        value: '57%',
        label: 'name identifying suitable use cases as their biggest hurdle – exactly where our assessment starts.',
        source: 'PwC / TU Munich, 2025',
      },
      {
        value: '76%',
        label: 'would pay a premium to keep their data in Europe – our platform is hosted in Germany.',
        source: 'adesso, 2026',
      },
    ],
  },
};

const t = content[lang];
---

<section id="markt" class="py-24 lg:py-32">
  <div class="container-narrow">
    <div class="max-w-2xl mb-14">
      <span class="inline-block px-4 py-2 bg-brand-blue/10 text-brand-blue-dark text-sm font-medium rounded-full mb-6 animate-on-scroll">
        {t.sectionTag}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold animate-on-scroll">
        {t.headline}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      {t.stats.map((s, index) => (
        <div class="border-t border-slate-200 pt-6 animate-on-scroll" style={`animation-delay: ${(index + 1) * 100}ms`}>
          <span class="block text-5xl lg:text-6xl font-bold text-gradient mb-4">{s.value}</span>
          <p class="text-slate-600 leading-relaxed mb-3">{s.label}</p>
          <p class="text-xs text-slate-400">{s.source}</p>
        </div>
      ))}
    </div>
  </div>
</section>
