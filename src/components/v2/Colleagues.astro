---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const content = {
  de: {
    sectionTag: 'Virtuelle Kollegen',
    headline: 'Die Funktionen, die im Mittelstand fehlen',
    intro: 'Auf der sicheren Plattform arbeiten virtuelle KI-Kollegen – jeder mit einem klaren Aufgabengebiet und dem Kontext Ihres Unternehmens. Bewusst als Unterstützung des Teams gedacht, nicht als Ersatz.',
    baseLabel: 'Immer dabei',
    rosterLabel: 'Spezial-Rollen – modular ergänzbar',
    rosterNote: 'Das Team virtueller Kollegen wächst Schritt für Schritt – priorisiert nach dem, was Ihr Unternehmen zuerst braucht.',
    base: {
      name: 'Bridget',
      role: 'Basis-Assistenz',
      text: 'Generalistin und sicherer KI-Zugang für alle – kennt den Unternehmenskontext und schützt vor Schatten-KI. Kommt immer mit der Plattform.',
    },
    roster: [
      { role: 'Prozesse & Operations', text: 'Nimmt Prozesse auf, deckt Effizienzpotenziale auf und macht konkrete Use-Cases sichtbar.', icon: 'process' },
      { role: 'Strategie & Management', text: 'Schafft auf Entscheider-Ebene Klarheit über Use-Cases und ihren wirtschaftlichen Nutzen.', icon: 'strategy' },
      { role: 'Finanzen & Controlling', text: 'Co-Pilot für Controlling und Buchhaltung – schneller Nutzen, als Unterstützung des Finanzteams.', icon: 'finance' },
      { role: 'Regularien & Compliance', text: 'Interne Richtlinien, Freigaben und europäische Datensouveränität – der Enabler für sichere Skalierung.', icon: 'legal' },
      { role: 'Marketing & Vertrieb', text: 'Unterstützt bei Content, Leads, Angeboten und Kundenkommunikation – entlastet das Team.', icon: 'marketing' },
      { role: 'Team & Entwicklung', text: 'Coach für Führungsteam und Mitarbeitende – bewusst als Coach, nicht als Kontrollinstanz.', icon: 'team' },
    ],
  },
  en: {
    sectionTag: 'Virtual colleagues',
    headline: 'The functions the Mittelstand is missing',
    intro: 'On the secure platform, virtual AI colleagues get to work – each with a clear remit and the context of your company. Designed to support the team, not to replace it.',
    baseLabel: 'Always included',
    rosterLabel: 'Specialist roles – add modularly',
    rosterNote: 'The team of virtual colleagues grows step by step – prioritized by what your company needs first.',
    base: {
      name: 'Bridget',
      role: 'Base assistant',
      text: 'A generalist and secure AI access for everyone – knows the company context and guards against shadow AI. Always comes with the platform.',
    },
    roster: [
      { role: 'Processes & operations', text: 'Captures processes, uncovers efficiency potential and makes concrete use cases visible.', icon: 'process' },
      { role: 'Strategy & management', text: 'Creates clarity at the decision-maker level about use cases and their economic value.', icon: 'strategy' },
      { role: 'Finance & controlling', text: 'A co-pilot for controlling and accounting – fast value, in support of the finance team.', icon: 'finance' },
      { role: 'Regulations & compliance', text: 'Internal policies, approvals and European data sovereignty – the enabler for safe scaling.', icon: 'legal' },
      { role: 'Marketing & sales', text: 'Supports content, leads, proposals and customer communication – relieves the team.', icon: 'marketing' },
      { role: 'Team & development', text: 'A coach for the leadership team and employees – deliberately a coach, not a control body.', icon: 'team' },
    ],
  },
};

const t = content[lang];

const icons: Record<string, string> = {
  process: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  strategy: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  finance: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  legal: 'M12 3l7 4v5c0 4.5-3 7.3-7 9-4-1.7-7-4.5-7-9V7l7-4z',
  marketing: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z',
  team: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4z',
};
---

<section id="kollegen" class="py-24 lg:py-32">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block px-4 py-2 bg-brand-navy/5 text-brand-navy text-sm font-medium rounded-full mb-6 animate-on-scroll">
        {t.sectionTag}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 animate-on-scroll">
        {t.headline}
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed animate-on-scroll">
        {t.intro}
      </p>
    </div>

    <!-- Base colleague -->
    <div class="max-w-5xl mx-auto mb-12 animate-on-scroll">
      <p class="text-sm font-semibold text-brand-navy uppercase tracking-wider mb-4">{t.baseLabel}</p>
      <div class="flex flex-col sm:flex-row items-start gap-6 p-8 bg-gradient-to-br from-brand-navy to-brand-blue-dark rounded-3xl text-white">
        <div class="w-16 h-16 flex-shrink-0 bg-white/15 rounded-2xl flex items-center justify-center text-2xl font-bold">
          {t.base.name.charAt(0)}
        </div>
        <div>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
            <h3 class="text-2xl font-bold">{t.base.name}</h3>
            <span class="text-brand-blue-light font-medium">{t.base.role}</span>
          </div>
          <p class="text-white/80 leading-relaxed">{t.base.text}</p>
        </div>
      </div>
    </div>

    <!-- Roster -->
    <div class="max-w-5xl mx-auto">
      <p class="text-sm font-semibold text-brand-navy uppercase tracking-wider mb-6 animate-on-scroll">{t.rosterLabel}</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {t.roster.map((c, index) => (
          <div class="card animate-on-scroll" style={`animation-delay: ${(index + 1) * 100}ms`}>
            <div class="w-12 h-12 flex-shrink-0 bg-brand-blue/10 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-blue-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[c.icon]} />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-brand-navy mb-2 leading-tight">{c.role}</h3>
            <p class="text-slate-600 leading-relaxed text-sm">{c.text}</p>
          </div>
        ))}
      </div>
      <p class="text-sm text-slate-500 leading-relaxed mt-8 max-w-2xl animate-on-scroll">{t.rosterNote}</p>
    </div>
  </div>
</section>
