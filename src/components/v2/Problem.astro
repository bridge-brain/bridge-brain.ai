---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const content = {
  de: {
    sectionTag: 'Die Ausgangslage',
    headline: 'Die Technik rast davon –\ndie Umsetzung bleibt zurück',
    intro: 'KI entwickelt sich exponentiell, die organisatorische Umsetzungsfähigkeit der Unternehmen nur langsam. Zwischen beidem öffnet sich eine Lücke – und genau hier setzt bridgebrAIn an.',
    stat: '13 %',
    statLabel: 'der Unternehmen haben KI voll im Einsatz. Der Rest hängt im Pilot fest.',
    statSource: 'adesso GenAI Impact Report, 2026',
    problemsLabel: 'Woran es konkret hakt',
    problems: [
      {
        title: 'Implementierungs-Lücke',
        text: 'Das Tempo der KI-Entwicklung überfordert: „Wir müssen KI einführen, wissen aber nicht, wie."',
        icon: 'gap',
      },
      {
        title: 'Management-Defizit',
        text: 'Strategische Funktionen sind im Mittelstand oft nur operativ besetzt – die Kapazität für die KI-Transformation fehlt.',
        icon: 'management',
      },
      {
        title: 'Shadow-AI-Risiko',
        text: 'Mitarbeitende nutzen privat ChatGPT & Co. – vertrauliche Daten fließen unkontrolliert ab.',
        icon: 'shield',
      },
    ],
  },
  en: {
    sectionTag: 'The starting point',
    headline: 'Technology races ahead –\nimplementation lags behind',
    intro: 'AI advances exponentially while organizations\' ability to implement grows only slowly. A gap opens between the two – and that is exactly where bridgebrAIn steps in.',
    stat: '13%',
    statLabel: 'of companies have AI fully in operation. The rest are stuck in pilots.',
    statSource: 'adesso GenAI Impact Report, 2026',
    problemsLabel: 'Where it actually breaks down',
    problems: [
      {
        title: 'Implementation gap',
        text: 'The pace of AI development is overwhelming: "We have to adopt AI, but we don\'t know how."',
        icon: 'gap',
      },
      {
        title: 'Management deficit',
        text: 'In SMEs, strategic functions are often staffed only operationally – the capacity for AI transformation is missing.',
        icon: 'management',
      },
      {
        title: 'Shadow-AI risk',
        text: 'Employees use ChatGPT & co. privately – confidential data leaks out uncontrolled.',
        icon: 'shield',
      },
    ],
  },
};

const t = content[lang];
---

<section id="problem" class="py-24 lg:py-32">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block px-4 py-2 bg-brand-navy/5 text-brand-navy text-sm font-medium rounded-full mb-6 animate-on-scroll">
        {t.sectionTag}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 animate-on-scroll">
        {t.headline.split('\n').map((line) => (<span class="block">{line}</span>))}
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed animate-on-scroll">
        {t.intro}
      </p>
    </div>

    <!-- Stat highlight -->
    <div class="max-w-3xl mx-auto mb-16 animate-on-scroll">
      <div class="flex flex-col sm:flex-row items-center gap-6 p-8 bg-brand-navy rounded-3xl text-white text-center sm:text-left">
        <span class="text-6xl lg:text-7xl font-bold text-brand-blue-light leading-none flex-shrink-0">{t.stat}</span>
        <div>
          <p class="text-lg text-white/80 leading-relaxed">{t.statLabel}</p>
          <p class="text-xs text-white/40 mt-2">{t.statSource}</p>
        </div>
      </div>
    </div>

    <!-- Problem cards -->
    <p class="text-sm font-semibold text-brand-navy uppercase tracking-wider mb-8 text-center animate-on-scroll">{t.problemsLabel}</p>
    <div class="grid md:grid-cols-3 gap-6">
      {t.problems.map((p, index) => (
        <div class="card animate-on-scroll" style={`animation-delay: ${(index + 1) * 100}ms`}>
          <div class="w-12 h-12 bg-brand-blue/10 rounded-xl flex items-center justify-center mb-5">
            {p.icon === 'gap' && (
              <svg class="w-6 h-6 text-brand-blue-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            )}
            {p.icon === 'management' && (
              <svg class="w-6 h-6 text-brand-blue-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4z" />
              </svg>
            )}
            {p.icon === 'shield' && (
              <svg class="w-6 h-6 text-brand-blue-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3l7 4v5c0 4.5-3 7.3-7 9-4-1.7-7-4.5-7-9V7l7-4z" />
              </svg>
            )}
          </div>
          <h3 class="text-lg font-semibold text-brand-navy mb-2">{p.title}</h3>
          <p class="text-slate-600 leading-relaxed">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
