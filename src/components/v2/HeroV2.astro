---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const hero = {
  de: {
    tagline: 'Aus dem Pilot in den Regelbetrieb',
    headline: 'Wir implementieren\nKI im Mittelstand',
    subheadline: 'Vom ersten Quick Win bis zum virtuellen Kollegen – sicher, in Deutschland gehostet und alles aus einer Hand.',
    description: 'Der Mittelstand weiß, dass er KI braucht. Er scheitert nicht am Wollen, sondern an der Umsetzung. bridgebrAIn bringt KI wirklich in den Betrieb – und verankert sie dauerhaft.',
    cta: 'Kontakt aufnehmen',
  },
  en: {
    tagline: 'From pilot to production',
    headline: 'We implement\nAI in the Mittelstand',
    subheadline: 'From the first quick win to your virtual colleague – secure, hosted in Germany, all from a single partner.',
    description: 'SMEs know they need AI. They don\'t fail on ambition, but on implementation. bridgebrAIn gets AI into real operation – and anchors it for good.',
    cta: 'Get in touch',
  }
};

const t = hero[lang];
---

<section class="relative min-h-[90vh] flex items-center pt-20 overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-20 right-0 w-[600px] h-[600px] bg-gradient-to-br from-brand-blue/5 via-brand-blue/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-brand-navy/5 to-transparent rounded-full blur-3xl"></div>

    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-[0.015]" style="background-image: linear-gradient(rgba(10,22,40,1) 1px, transparent 1px), linear-gradient(90deg, rgba(10,22,40,1) 1px, transparent 1px); background-size: 60px 60px;"></div>
  </div>

  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center">
      <!-- Tagline -->
      <div class="animate-slide-up opacity-0 delay-100">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-brand-blue/10 text-brand-blue-dark text-sm font-medium rounded-full mb-8">
          <span class="w-2 h-2 bg-brand-blue rounded-full animate-pulse"></span>
          {t.tagline}
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold leading-[1.1] mb-8 animate-slide-up opacity-0 delay-200">
        {t.headline.split('\n').map((line, i) => (
          <span class:list={["block", i === 1 && "text-gradient"]}>{line}</span>
        ))}
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-xl mx-auto mb-6 animate-slide-up opacity-0 delay-300">
        {t.subheadline}
      </p>

      <!-- Description -->
      <p class="text-base text-slate-500 leading-relaxed max-w-2xl mx-auto mb-10 animate-slide-up opacity-0 delay-400">
        {t.description}
      </p>

      <!-- CTA -->
      <div class="animate-slide-up opacity-0 delay-500">
        <a
          href="#kontakt"
          class="inline-flex items-center gap-2 px-8 py-4 bg-brand-navy text-white font-medium rounded-full hover:bg-brand-blue-dark transition-all duration-300 hover:shadow-lg hover:shadow-brand-navy/20 group"
        >
          {t.cta}
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
